---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import { siteConfig } from "src/config/site-config";
import { getEntry } from "astro:content";

export const getStaticPaths = (async () => {
    const blogPosts = await getCollection("blog");

    return blogPosts.map((post) => ({
        params: { slug: post.slug },
        props: { post: post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const frontmatter = post.data;

const { Content, headings } = await post.render();

const author = (await getEntry("author", post.data.author.id))?.data;
---

<MainLayout pageTitle={frontmatter.title}>
    <div
        id="btn-goBack"
        class="blog max-w-6xl mx-auto px-6 py-10"
    >
        <h1
            class="text-3xl font-semibold text-gray-800 capitalize lg:text-4xl dark:text-white"
        >
            {siteConfig.title}
        </h1>

        <a class="py-3 rounded-sm" href="/">Regresar</a>

        {
            author && (
                <div class="text-md text-gray-400 mt-12 flex flex-row">
                    <Image
                        src={author.avatar}
                        alt={author.name}
                        class="rounded-full"
                        width={50}
                        height={50}
                    />
                    <div class="flex flex-col ml-5">
                        <a href={ `/blog/${frontmatter.author.id}` }>{author.name}</a>
                        <span class="text-xs text-gray-200">
                            {frontmatter.date}
                        </span>
                    </div>
                </div>
            )
        }

        <h1 class="text-xs text-gray-500 mb-0">{frontmatter.title}</h1>

        <!-- Image -->
        <Image
            class="object-cover w-2/6 rounded-lg"
            src={frontmatter.image}
            alt={frontmatter.title}
            transition:name={`${post.slug}-image`}
            width={600}
            height={220}
            quality="low"
            loading="lazy"
        />

        <h1>Tabla de contenidos</h1>

        <ol>
            {
                headings.map((heading, index) => (
                    <li>
                        <a href={`#${heading.slug}`}>
                            {index + 1} - {heading.text}
                        </a>
                    </li>
                ))
            }
        </ol>

        <!-- Contenido -->
        <Content />

        <div class="my-20">
            <a href="#btn-goBack">Ir arriba</a>
        </div>
    </div>
</MainLayout>
