---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import { siteConfig } from "src/config/site-config";

export const getStaticPaths = (async () => {
    const blogPosts = await getCollection("blog");

    return blogPosts.map((post) => ({
        params: { slug: post.slug },
        props: { post: post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const frontmatter = post.data;

const { Content, headings } = await post.render();
---

<MainLayout pageTitle={frontmatter.title}>
    <div
        class="blog max-w-6xl mx-auto p-8 rounded-xl shadow-xl backdrop-blur-md space-y-6"
    >
        <h1
            class="text-3xl font-semibold text-gray-800 capitalize lg:text-4xl dark:text-white"
        >
            {siteConfig.title}
        </h1>

        <a
            href="/"
            id="btn-goBack"
            class="inline-block no-underline text-blue-600 hover:text-blue-800 text-sm font-semibold py-2 px-4 rounded transition"
        >
            Regresar
        </a>

        <h1 class="text-xs text-gray-500 mb-0">{frontmatter.title}</h1>
        <h4 class="text-md text-gray-400 mb-0">{frontmatter.author}</h4>

        <!-- Image -->
        <Image
            class="object-cover w-2/6 rounded-lg"
            src={frontmatter.image}
            alt={frontmatter.title}
            transition:name={`${post.slug}-image`}
            width={600}
            height={220}
            quality="low"
            loading="lazy"
        />

        <h1>Tabla de contenidos</h1>

        <ol>
            {
                headings.map((heading, index) => (
                    <li>
                        <a href={`#${heading.slug}`}>
                            {index + 1} - {heading.text}
                        </a>
                    </li>
                ))
            }
        </ol>

        <!-- Contenido -->
        <Content />

        <div class="my-20">
            <a href="#btn-goBack">Ir arriba</a>
        </div>
    </div>
</MainLayout>
