---
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site-config";
import MainLayout from "../layouts/MainLayout.astro";
import TypedBlogPost from "src/components/TypedBlogPost.astro";

const blogPosts = await getCollection(
	'blog',
	(post) => post.data.isDraft === false
);
---

<MainLayout>
	<!-- component -->
	<section class="max-w-6xl mx-auto">
		<div class="px-6 py-10">
			<h1
				class="text-3xl font-semibold text-gray-800 capitalize lg:text-4xl dark:text-white"
			>
				{siteConfig.title}
			</h1>

			<!-- <button class="btn-primary">
				<a href="/blog/1">Blog paginado</a>
			</button> -->

			<section aria-label="Entradas de blog">
				<div
					class="grid grid-cols-1 gap-8 mt-4 md:mt-8 md:grid-cols-2 sm:grid-cols-2"
				>
					{blogPosts.map((post) => <TypedBlogPost post={post} />)}
				</div>
			</section>
		</div>
	</section>
</MainLayout>
